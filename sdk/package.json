{
  "name": "@airz/rundown-sdk",
  "version": "0.1.0",
  "description": "Framework-agnostic TypeScript client for the airZ Studio Rundown API (/api/v1): auth, playlist-item data-binding push, triggers, live SSE sync, panel mapping, and realtime helpers.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "airz",
    "broadcast",
    "rundown",
    "graphics",
    "data-binding",
    "sse",
    "sdk"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "watch": "tsc -p tsconfig.json --watch",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run build"
  },
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "restricted"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "typescript": "^5.6.0"
  }
}
